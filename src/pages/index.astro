---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Arrow from '../components/Arrow.astro';
import Footer from '../components/Footer.astro';
import TopBar from '../components/TopBar.astro';
import { about, beliefs, education, interests, languages, profile, projects, route, skills, work } from '../data/profile';
import { getPosts, postDate, transitionName } from '../lib/writing';

const posts = await getPosts();
const postTitle = (id: string) => posts.find((p) => p.id === id)?.data.title;

const years = (start: string, end: string) => (start === end ? start : `${start} – ${end}`);
const external = { target: '_blank', rel: 'noopener noreferrer' };
// Links into iamsushant.dev itself (like /photos/) stay in the same tab, as root-relative paths, so the
// browser treats them as same-site navigations and runs the page transition.
const local = (href: string) => (href.startsWith(profile.url) ? href.slice(profile.url.length) || '/' : null);

let n = 0;
const next = () => String(++n).padStart(2, '0');

const mono = 'font-mono text-[0.78rem] text-ink-3';
const rowGrid =
  'grid gap-1.5 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-6 print:grid-cols-[6.5rem_minmax(0,1fr)] print:gap-4';
---

<Base>
  <div aria-hidden="true" class="progress fixed inset-x-0 top-0 z-20 h-0.5 bg-accent print:hidden"></div>
  <TopBar active="about" />
  <div class="mx-auto max-w-[70rem] px-[clamp(1.25rem,5vw,3.5rem)]">
    <!-- The name lives in the top bar; the hero leads with what I do. -->
    <header class="pt-[clamp(4rem,12vw,9.5rem)] pb-[clamp(3.5rem,9vw,6.5rem)] print:p-0 print:pb-5">
      <p class="hidden font-serif text-[30pt] leading-none print:mb-3 print:block">{profile.name}</p>
      <p class="flex items-start gap-2.5 font-mono text-[0.8rem] text-ink-2 motion-safe:animate-rise">
        <span class="mt-[0.5em] size-[0.45rem] shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        {profile.role} at {profile.company} · {profile.location}
      </p>
      <h1
        class="mt-7 max-w-[15em] font-serif text-statement text-balance motion-safe:animate-rise motion-safe:[animation-delay:80ms] print:mt-2 print:max-w-none print:text-[15pt] [&_em]:text-accent [&_em]:not-italic"
      >
        I'm Sushant. I build AI-powered products end to end: <em>the systems underneath</em>, the <em>LLM layer</em>,
        and the <em>interface</em> people actually touch.
      </h1>
      <nav
        aria-label="Elsewhere"
        class="mt-11 flex flex-wrap gap-x-7 gap-y-2 font-mono text-[0.85rem] motion-safe:animate-rise motion-safe:[animation-delay:160ms] print:hidden"
      >
        <a class="group link" href={`mailto:${profile.email}`}>Email <Arrow newTab={false} /></a>
        <a class="group link" href={profile.linkedin} {...external}>LinkedIn <Arrow /></a>
        <a class="group link" href={profile.github} {...external}>GitHub <Arrow /></a>
        <a class="group link" href="/writing/">Writing <Arrow internal /></a>
      </nav>
      <p class="hidden font-mono text-[8.5pt] text-ink-2 print:mt-3 print:block">
        {
          [profile.email, profile.linkedin, profile.github, profile.url]
            .map((u) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''))
            .join('  ·  ')
        }
      </p>
    </header>

    <main id="main">
      <Section id="about" index={next()} title="About">
        <div class="grid max-w-[38rem] gap-4 text-[1.1rem] leading-relaxed text-pretty text-ink-2 print:max-w-none print:gap-2">
          {
            about.map((paragraph, i) => (
              <p class={i === 0 ? 'text-[clamp(1.2rem,2vw,1.4rem)] leading-normal tracking-[-0.01em] text-ink print:text-[1.2rem]' : ''}>
                {paragraph}
              </p>
            ))
          }
        </div>
        <ol class="mt-10 flex flex-wrap items-baseline gap-x-3 gap-y-2 font-mono text-[0.78rem] print:hidden" aria-label="Where I've been">
          {
            route.map((stop, i) => (
              <li class="flex items-baseline gap-3">
                {i > 0 && <span class="text-ink-3" aria-hidden="true">→</span>}
                <span>
                  <span class={i === route.length - 1 ? 'text-accent' : 'text-ink-2'}>{stop.place}</span>
                  <span class="text-ink-3"> {stop.year} · {stop.what}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="experience" index={next()} title="Experience">
        <ol class="grid gap-14 print:gap-5" role="list">
          {
            work.map((job) => (
              <li class={rowGrid}>
                <span class={`${mono} leading-[1.9] tabular-nums`}>{years(job.start, job.end)}</span>
                <div>
                  <h3 class="text-[1.15rem] leading-snug font-[520] tracking-[-0.012em]">
                    {job.role} <span class="font-normal text-ink-3">at</span> {job.company}
                  </h3>
                  <p class="text-[0.9rem] text-ink-3">
                    {job.place}
                    {job.previously && <> · previously {job.previously}</>}
                  </p>
                  <ul class="mt-4 grid max-w-[38rem] gap-2 text-ink-2 print:mt-1.5 print:max-w-none print:gap-0.5" role="list">
                    {job.highlights.map((h) => (
                      <li class="relative pl-5 text-pretty before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-ink-3">
                        {h}
                      </li>
                    ))}
                  </ul>
                  <ul class="mt-5 flex flex-wrap gap-1.5 print:hidden" role="list">
                    {job.stack.map((tech) => (
                      <li class="rounded-full border border-rule px-2.5 py-0.5 font-mono text-[0.72rem] text-ink-2">{tech}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>

        <h3 class="mt-16 border-t border-dashed border-rule pt-8 font-mono text-xs tracking-wider text-ink-3 uppercase print:mt-5 print:pt-3">
          Education
        </h3>
        <ul class="mt-4 grid gap-2.5 text-ink-2" role="list">
          {
            education.map((e) => (
              <li class={rowGrid}>
                <span class={`${mono} leading-[1.9]`}>{e.year}</span>
                <span>
                  {e.degree} <span class="text-ink-3">at</span> {e.school}
                </span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="skills" index={next()} title="Skills">
        <dl class="grid gap-7">
          {
            [...skills, { group: 'Languages', items: languages }].map((s) => (
              <div class={rowGrid}>
                <dt class={`${mono} leading-[1.9]`}>{s.group}</dt>
                <dd class="max-w-[38rem] leading-relaxed text-ink-2">{s.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <Section id="projects" index={next()} title="Projects">
        <ul role="list">
          {
            projects.map((project) => (
              <li class="group relative isolate grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-8 gap-y-2.5 border-b border-rule py-8 first:pt-1 before:absolute before:inset-y-0 before:-inset-x-5 before:-z-10 before:rounded-2xl before:bg-accent/6 before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-100 print:py-2.5">
                <h3 class="font-serif text-project print:text-[14pt]">
                  <a
                    href={local(project.href) ?? project.href}
                    {...(local(project.href) ? {} : external)}
                    class="transition-colors group-hover:text-accent after:absolute after:inset-0 after:content-['']"
                  >
                    {project.name}
                    {!local(project.href) && <span class="sr-only"> (opens in a new tab)</span>}
                  </a>
                </h3>
                <span class={mono}>{project.year}</span>
                <p class="col-span-full max-w-[38rem] text-pretty text-ink-2">{project.summary}</p>
                <div class={`${mono} col-span-full mt-1 flex flex-wrap justify-between gap-x-6 gap-y-2`}>
                  <span>{project.stack.join(' · ')}</span>
                  {project.source && (
                    <a class="group/source link relative z-10 text-ink-2" href={project.source} {...external}>
                      Source{' '}
                      <span
                        aria-hidden="true"
                        class="inline-block transition-transform duration-300 ease-soft group-hover/source:translate-x-[0.12em] group-hover/source:-translate-y-[0.12em]"
                      >
                        ↗
                      </span>
                      <span class="sr-only"> (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="writing" index={next()} title="Writing" screenOnly>
        <ul role="list">
          {
            posts.slice(0, 3).map((post) => (
              <li>
                <a
                  href={`/writing/${post.id}/`}
                  class="group grid gap-x-6 gap-y-1 border-b border-rule py-5 sm:grid-cols-[7.5rem_minmax(0,1fr)_auto] sm:items-baseline"
                >
                  <time class={mono} datetime={post.data.date.toISOString().slice(0, 10)}>
                    {postDate.format(post.data.date)}
                  </time>
                  <span class="grid gap-0.5">
                    <span
                      class="w-fit text-[1.15rem] font-medium tracking-[-0.012em] transition-colors group-hover:text-accent"
                      style={`view-transition-name: ${transitionName(post)}`}
                    >
                      {post.data.title}
                    </span>
                    <span class="text-ink-2">{post.data.description}</span>
                  </span>
                  <span class={mono}>
                    {post.data.draft ? 'Draft' : 'Read'} <Arrow internal />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 flex flex-wrap justify-between gap-x-6 gap-y-2 font-mono text-[0.78rem] text-ink-3">
          <a class="group link text-ink-2" href="/writing/">All writing <Arrow internal /></a>
          <span>New posts by feed: <a class="group link text-ink-2" href="/rss.xml">RSS <Arrow internal /></a></span>
        </p>
      </Section>

      <Section id="beliefs" index={next()} title="What I believe" screenOnly>
        <ol class="grid gap-9" role="list">
          {
            beliefs.map((belief) => (
              <li>
                <blockquote class="max-w-[40rem] font-serif text-[clamp(1.6rem,3.2vw,2.3rem)] leading-[1.12] tracking-[-0.015em] text-balance">
                  {belief.text}
                </blockquote>
                <p class="mt-2.5 font-mono text-[0.75rem] text-ink-3">
                  {belief.credit && <>Borrowed from {belief.credit} · </>}
                  <a class="group link" href={`/writing/${belief.post}/`}>
                    From “{postTitle(belief.post)}” <Arrow internal />
                  </a>
                </p>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="outside-work" index={next()} title="Outside work">
        <ul class="grid gap-10 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3" role="list">
          {
            interests.map((interest) => {
              const href = interest.link && (local(interest.link.href) ?? interest.link.href);
              const isExternal = href?.startsWith('http');
              return (
                <li class="border-t border-rule pt-5">
                  <h3
                    class="w-fit font-serif text-[1.75rem] leading-tight"
                    style={href === '/photos/' ? 'view-transition-name: photos-heading' : undefined}
                  >
                    {interest.title}
                  </h3>
                  <p class="mt-2 max-w-[30rem] text-pretty text-ink-2">{interest.body}</p>
                  {interest.link && (
                    <a
                      class="group link mt-4 inline-block font-mono text-[0.8rem] text-ink-2 print:hidden"
                      href={href}
                      {...(isExternal ? external : {})}
                    >
                      {interest.link.label} <Arrow internal={!isExternal} />
                    </a>
                  )}
                </li>
              );
            })
          }
        </ul>
      </Section>

      <section aria-labelledby="contact-title" class="reveal border-t border-rule py-[clamp(5rem,14vw,10rem)] print:hidden">
        <h2 id="contact-title" class="font-serif text-headline">
          Say <span class="text-accent">hello.</span>
        </h2>
        <p class="mt-7 text-ink-2">Email is the quickest way to reach me.</p>
        <a
          class="mt-1.5 inline-block text-[clamp(1.25rem,3.2vw,2rem)] tracking-[-0.015em] underline decoration-accent decoration-2 underline-offset-[0.2em] transition-colors hover:text-accent"
          href={`mailto:${profile.email}`}
        >
          {profile.email}
        </a>
        <div class="mt-16 grid gap-2 font-mono text-[0.8rem] text-ink-3">
          <p>
            Prefer a terminal?
            <code class="ml-1 rounded-md border border-rule px-2 py-1 text-ink-2 select-all">curl iamsushant.dev/cv.txt</code>
          </p>
          <p>Need a CV? Print this page and it turns into one.</p>
          <p>
            Asking an AI about me? Point it at <a class="link text-ink-2" href="/llms.txt">iamsushant.dev/llms.txt</a>.
          </p>
        </div>
      </section>
    </main>

    <Footer />
  </div>
</Base>
