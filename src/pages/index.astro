---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Arrow from '../components/Arrow.astro';
import { about, education, interests, languages, profile, projects, skills, work, writing } from '../data/profile';

const postDate = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric' });
const years = (start: string, end: string) => (start === end ? start : `${start} – ${end}`);
const updated = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(new Date());

let n = 0;
const next = () => String(++n).padStart(2, '0');

const mono = 'font-mono text-[0.78rem] text-ink-3';
const rowGrid = 'grid gap-1.5 sm:grid-cols-[7.5rem_minmax(0,1fr)] sm:gap-6 print:grid-cols-[6.5rem_minmax(0,1fr)] print:gap-4';
---

<Base>
  <div aria-hidden="true" class="progress fixed inset-x-0 top-0 z-20 h-0.5 bg-accent print:hidden"></div>
  <div class="mx-auto max-w-[70rem] px-[clamp(1.25rem,5vw,3.5rem)]">
    <header class="flex flex-col justify-end pt-24 pb-[clamp(3rem,8vw,5.5rem)] sm:min-h-[min(94svh,58rem)] sm:pt-28 print:min-h-0 print:p-0 print:pb-5">
      <p class="flex items-start gap-2.5 font-mono text-[0.8rem] text-ink-2 motion-safe:animate-rise">
        <span class="mt-[0.5em] size-[0.45rem] shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        {profile.location} · {profile.role} at {profile.company}
      </p>
      <h1 class="mt-6 mb-9 font-serif text-display print:my-3 print:text-[38pt] motion-safe:animate-rise motion-safe:[animation-delay:80ms]">
        Sushant <span class="text-ink-2">Nandwani</span>
      </h1>
      <p
        class="max-w-[36rem] text-lede text-balance max-sm:min-h-[4lh] print:min-h-0 print:max-w-none print:text-[12.5pt] motion-safe:animate-rise motion-safe:[animation-delay:160ms] [&_em]:text-accent [&_em]:not-italic"
      >
        I build AI-powered products end to end: <em>Java services</em>, the <em>LLM layer</em>,
        and the <em>interface</em> people actually touch.
      </p>
      <nav
        aria-label="Elsewhere"
        class="mt-11 flex flex-wrap gap-x-7 print:hidden gap-y-2 font-mono text-[0.85rem] motion-safe:animate-rise motion-safe:[animation-delay:240ms]"
      >
        <a class="group link" href={`mailto:${profile.email}`}>Email <Arrow /></a>
        <a class="group link" href={profile.linkedin}>LinkedIn <Arrow /></a>
        <a class="group link" href={profile.github}>GitHub <Arrow /></a>
      </nav>
      <p class="hidden font-mono text-[8.5pt] text-ink-2 print:mt-3 print:block">
        {[profile.email, profile.linkedin, profile.github, profile.url].map((u) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')).join('  ·  ')}
      </p>
    </header>

    <main id="main">
      <Section id="about" index={next()} title="About">
        <div class="grid max-w-[38rem] gap-4 print:max-w-none print:gap-2 text-[1.1rem] leading-relaxed text-pretty text-ink-2">
          {
            about.map((paragraph, i) => (
              <p class={i === 0 ? 'text-[clamp(1.2rem,2vw,1.4rem)] leading-normal tracking-[-0.01em] text-ink print:text-[1.2rem]' : ''}>
                {paragraph}
              </p>
            ))
          }
        </div>
      </Section>

      <Section id="experience" index={next()} title="Experience">
        <ol class="grid gap-14 print:gap-5" role="list">
          {
            work.map((job) => (
              <li class={rowGrid}>
                <span class={`${mono} leading-[1.9] tabular-nums`}>{years(job.start, job.end)}</span>
                <div>
                  <h3 class="text-[1.15rem] leading-snug font-[520] tracking-[-0.012em]">
                    {job.role} <span class="font-normal text-ink-3">at</span> {job.company}
                  </h3>
                  <p class="text-[0.9rem] text-ink-3">
                    {job.place}
                    {job.previously && <> · previously {job.previously}</>}
                  </p>
                  <ul class="mt-4 grid max-w-[38rem] gap-2 text-ink-2 print:mt-1.5 print:max-w-none print:gap-0.5" role="list">
                    {job.highlights.map((h) => (
                      <li class="relative pl-5 text-pretty before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-ink-3">
                        {h}
                      </li>
                    ))}
                  </ul>
                  <ul class="mt-5 flex flex-wrap gap-1.5 print:hidden" role="list">
                    {job.stack.map((tech) => (
                      <li class="rounded-full border border-rule px-2.5 py-0.5 font-mono text-[0.72rem] text-ink-2">{tech}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>

        <h3 class="mt-16 border-t border-dashed border-rule pt-8 print:mt-5 print:pt-3 font-mono text-xs tracking-wider text-ink-3 uppercase">
          Education
        </h3>
        <ul class="mt-4 grid gap-2.5 text-ink-2" role="list">
          {
            education.map((e) => (
              <li class={rowGrid}>
                <span class={`${mono} leading-[1.9]`}>{e.year}</span>
                <span>
                  {e.degree} <span class="text-ink-3">at</span> {e.school}
                </span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="skills" index={next()} title="Skills">
        <dl class="grid gap-7">
          {
            [...skills, { group: 'Languages', items: languages }].map((s) => (
              <div class={rowGrid}>
                <dt class={`${mono} leading-[1.9]`}>{s.group}</dt>
                <dd class="max-w-[38rem] leading-relaxed text-ink-2">{s.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <Section id="projects" index={next()} title="Projects">
        <ul role="list">
          {
            projects.map((project) => (
              <li class="group relative isolate grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-8 gap-y-2.5 border-b border-rule py-8 first:pt-1 print:py-2.5 before:absolute before:inset-y-0 before:-inset-x-5 before:-z-10 before:rounded-2xl before:bg-accent/6 before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-100">
                <h3 class="font-serif text-project print:text-[14pt]">
                  <a
                    href={project.href}
                    class="transition-colors group-hover:text-accent after:absolute after:inset-0 after:content-['']"
                  >
                    {project.name}
                  </a>
                </h3>
                <span class={mono}>{project.year}</span>
                <p class="col-span-full max-w-[38rem] text-pretty text-ink-2">{project.summary}</p>
                <div class={`${mono} col-span-full mt-1 flex flex-wrap justify-between gap-x-6 gap-y-2`}>
                  <span>{project.stack.join(' · ')}</span>
                  {project.source && (
                    <a class="group/source link relative z-10 text-ink-2" href={project.source}>
                      Source{' '}
                      <span
                        aria-hidden="true"
                        class="inline-block transition-transform duration-300 ease-soft group-hover/source:translate-x-[0.12em] group-hover/source:-translate-y-[0.12em]"
                      >
                        ↗
                      </span>
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="writing" index={next()} title="Writing" screenOnly>
        <ul role="list">
          {
            writing.map((post) => (
              <li>
                <a
                  href={post.href}
                  class="group grid gap-x-6 gap-y-1 border-b border-rule py-5 sm:grid-cols-[7.5rem_minmax(0,1fr)_auto] sm:items-baseline"
                >
                  <time class={mono} datetime={post.date}>
                    {postDate.format(new Date(post.date))}
                  </time>
                  <span class="grid gap-0.5">
                    <span class="text-[1.15rem] font-medium tracking-[-0.012em] transition-colors group-hover:text-accent">
                      {post.title}
                    </span>
                    <span class="text-ink-2">{post.blurb}</span>
                  </span>
                  <span class={mono}>
                    LinkedIn <Arrow />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="outside-work" index={next()} title="Outside work">
        <ul class="grid gap-10 sm:grid-cols-2 sm:gap-8" role="list">
          {
            interests.map((interest) => (
              <li class="border-t border-rule pt-5">
                <h3 class="font-serif text-[1.75rem] leading-tight">{interest.title}</h3>
                <p class="mt-2 max-w-[30rem] text-pretty text-ink-2">{interest.body}</p>
                {interest.link && (
                  <a class="group link mt-4 inline-block font-mono text-[0.8rem] text-ink-2" href={interest.link.href}>
                    {interest.link.label} <Arrow />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </Section>

      <section aria-labelledby="contact-title" class="reveal border-t border-rule py-[clamp(5rem,14vw,10rem)] print:hidden">
        <h2 id="contact-title" class="font-serif text-headline">
          Say <span class="text-accent">hello.</span>
        </h2>
        <p class="mt-7 text-ink-2">Email is the quickest way to reach me.</p>
        <a
          class="mt-1.5 inline-block text-[clamp(1.25rem,3.2vw,2rem)] tracking-[-0.015em] underline decoration-accent decoration-2 underline-offset-[0.2em] transition-colors hover:text-accent"
          href={`mailto:${profile.email}`}
        >
          {profile.email}
        </a>
        <div class="mt-16 grid gap-2 font-mono text-[0.8rem] text-ink-3">
          <p>
            Prefer a terminal?
            <code class="ml-1 rounded-md border border-rule px-2 py-1 text-ink-2 select-all">curl iamsushant.dev/cv.txt</code>
          </p>
          <p>Need a CV? Print this page and it turns into one.</p>
        </div>
      </section>
    </main>

    <footer class="print:hidden flex flex-wrap justify-between gap-x-8 gap-y-3 border-t border-rule pt-8 pb-12 font-mono text-[0.72rem] leading-relaxed text-ink-3">
      <span>© {new Date().getFullYear()} {profile.name}</span>
      <span>Set in Instrument Serif, Geist and Geist Mono. Built with Astro and Tailwind, no client-side JavaScript.</span>
      <span>Updated {updated}</span>
    </footer>
  </div>
</Base>
