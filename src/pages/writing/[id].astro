---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import Footer from '../../components/Footer.astro';
import TopBar from '../../components/TopBar.astro';
import ExternalLinksInNewTab from '../../components/ExternalLinksInNewTab.astro';
import { profile } from '../../data/profile';
import { getPosts, postDate, readingTime, transitionName, type Post } from '../../lib/writing';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Base
  title={`${post.data.title} · ${profile.name}`}
  description={post.data.description}
  article={{ published: post.data.date, headline: post.data.title }}
  noindex={post.data.draft}
>
  <TopBar active="writing" />
  <div class="mx-auto max-w-[70rem] px-[clamp(1.25rem,5vw,3.5rem)]">

    <main id="main" class="mx-auto max-w-[42rem] pt-[clamp(3rem,9vw,6rem)] pb-24">
      <article>
        <header>
          <p class="font-mono text-[0.78rem] text-ink-3">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{postDate.format(post.data.date)}</time>{' '}
            · {readingTime(post.body)}
            {post.data.draft && <span class="text-accent"> · draft</span>}
          </p>
          <h1
            class="mt-4 font-serif text-[clamp(2.6rem,7vw,4.5rem)] leading-[0.98] tracking-[-0.025em] text-balance"
            style={`view-transition-name: ${transitionName(post)}`}
          >
            {post.data.title}
          </h1>
          <p class="mt-6 text-[clamp(1.15rem,2vw,1.35rem)] leading-normal text-pretty text-ink-2">{post.data.description}</p>
        </header>

        <div class="prose mt-12 border-t border-rule pt-10">
          <ExternalLinksInNewTab><Content /></ExternalLinksInNewTab>
        </div>

        <div class="mt-12 grid gap-1.5 font-mono text-[0.8rem] text-ink-3 print:hidden">
          {
            post.data.linkedin && (
              <p>
                Also posted on{' '}
                <a class="group link text-ink-2" href={post.data.linkedin} target="_blank" rel="noopener noreferrer">
                  LinkedIn <Arrow />
                </a>
              </p>
            )
          }
          <p>
            Get the next one by feed:{' '}
            <a class="group link text-ink-2" href="/rss.xml">RSS <Arrow internal /></a>
          </p>
        </div>
      </article>

      <nav class="mt-16 grid gap-6 border-t border-rule pt-8 sm:grid-cols-2 print:hidden" aria-label="More writing">
        {
          older && (
            <a class="group block" href={`/writing/${older.id}/`}>
              <span class="font-mono text-[0.75rem] text-ink-3">Older</span>
              <span class="mt-1 block font-serif text-[1.6rem] leading-tight transition-colors group-hover:text-accent">
                {older.data.title}
              </span>
            </a>
          )
        }
        {
          newer && (
            <a class="group block sm:col-start-2 sm:text-right" href={`/writing/${newer.id}/`}>
              <span class="font-mono text-[0.75rem] text-ink-3">Newer</span>
              <span class="mt-1 block font-serif text-[1.6rem] leading-tight transition-colors group-hover:text-accent">
                {newer.data.title}
              </span>
            </a>
          )
        }
      </nav>

      <p class="mt-16 text-ink-2 print:hidden">
        Thoughts on this? <a class="link text-ink" href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </main>

    <Footer />
  </div>
</Base>
