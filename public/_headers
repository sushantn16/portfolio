# Response headers for Cloudflare's static asset hosting. This file is read by Cloudflare, not served.

# Astro fingerprints everything in /_astro/, so a changed file gets a new name: cache it for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The page ships no JavaScript, so the policy can forbid scripts outright. JSON-LD is a data
# block, not a script, so it isn't affected. Inline styles are allowed because the CSS is inlined.
/*
  Content-Security-Policy: default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
